# Nada con datos de clientes sale de esta máquina (constitución §6).
# La regla es la carpeta, no el archivo: si nombra un expediente, va en _PRIVADO.
_PRIVADO/

# Respaldos del registro de Windows: son de esta máquina, no del diseño.
_estado/
_respaldo*/

# El panel se regenera solo: no se versiona el resultado, si el generador.
panel.html

# Herramientas de terceros que se descargan: no se versionan.
_herramientas/

# Basura de Python, se regenera sola.
__pycache__/
*.pyc

# Temporales de Office: aparecen mientras un .md o .docx esta abierto
# en Word y desaparecen al cerrarlo. Nunca se versionan.
~$*
